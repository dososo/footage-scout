{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://footage-scout.invalid/candidate_set.schema.json",
  "title": "candidate_set",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "brief": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "use": {
          "enum": [
            "personal_noncommercial",
            "commercial"
          ],
          "default": "personal_noncommercial"
        },
        "ai": {
          "enum": [
            "none",
            "local_analysis",
            "generative"
          ],
          "default": "none"
        },
        "dataset_or_training": {
          "type": "boolean",
          "default": false
        },
        "documentary": {
          "type": "boolean",
          "default": false
        },
        "strict_provenance": {
          "type": "boolean",
          "default": false
        },
        "purpose": {
          "type": "string"
        },
        "orientation": {
          "enum": [
            "landscape",
            "portrait",
            "square"
          ]
        },
        "shots": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "shot_id": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "queries": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "topics": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "duration_s": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "will_edit": {
                "type": "boolean",
                "default": true
              }
            },
            "required": [
              "shot_id",
              "description",
              "queries",
              "topics",
              "duration_s"
            ]
          },
          "minItems": 1
        }
      },
      "required": [
        "schema_version",
        "title",
        "use",
        "ai",
        "orientation",
        "shots"
      ]
    },
    "brief_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schema_version": {
            "const": "1.0.0"
          },
          "asset_id": {
            "type": "string",
            "minLength": 1
          },
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "shot_id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "author": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_page": {
            "type": "string",
            "pattern": "^https?://"
          },
          "file_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "bytes_total": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "tier": {
            "enum": [
              "T1",
              "T2",
              "T3",
              "T4"
            ]
          },
          "provenance": {
            "enum": [
              "camera",
              "ai_generated",
              "animation",
              "unknown"
            ]
          },
          "license": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "license_id": {
                "type": "string",
                "minLength": 1
              },
              "attribution_required": {
                "enum": [
                  "yes",
                  "no",
                  "unknown",
                  "per_item"
                ]
              },
              "derivatives": {
                "enum": [
                  "yes",
                  "no",
                  "unknown",
                  "per_item"
                ]
              },
              "commercial": {
                "enum": [
                  "yes",
                  "no",
                  "unknown",
                  "per_item"
                ]
              },
              "ai_use": {
                "enum": [
                  "allowed",
                  "no_training",
                  "no_generative_processing",
                  "disclose_ai_modification",
                  "unknown",
                  "per_item"
                ]
              },
              "third_party_rights_flag": {
                "type": "boolean"
              },
              "purpose_restriction": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "terms_url": {
                "type": "string",
                "pattern": "^https?://"
              },
              "terms_snapshot_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "license_id",
              "attribution_required",
              "derivatives",
              "commercial",
              "ai_use",
              "third_party_rights_flag",
              "purpose_restriction"
            ]
          },
          "media": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "duration_s": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "width": {
                "type": "integer",
                "minimum": 1
              },
              "height": {
                "type": "integer",
                "minimum": 1
              },
              "fps": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "codec": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "duration_s",
              "width",
              "height"
            ]
          },
          "gate": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "verdict": {
                "enum": [
                  "PASS",
                  "WARN",
                  "HOLD",
                  "BLOCK"
                ]
              },
              "rules": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^R[1-9]$"
                }
              },
              "artifact_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "verdict",
              "rules"
            ]
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "scorer": {
            "enum": [
              "siglip",
              "clip",
              "agent",
              "none"
            ]
          },
          "relevance": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "similarity": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          }
        },
        "required": [
          "schema_version",
          "asset_id",
          "source_id",
          "shot_id",
          "title",
          "author",
          "source_page",
          "file_url",
          "tier",
          "provenance",
          "license",
          "gate"
        ]
      }
    },
    "notices": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema_version",
    "brief",
    "brief_sha256",
    "candidates",
    "notices"
  ]
}
