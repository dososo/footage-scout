{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://footage-scout.invalid/brief.schema.json",
  "title": "brief",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "use": {
      "enum": [
        "personal_noncommercial",
        "commercial"
      ],
      "default": "personal_noncommercial"
    },
    "ai": {
      "enum": [
        "none",
        "local_analysis",
        "generative"
      ],
      "default": "none"
    },
    "dataset_or_training": {
      "type": "boolean",
      "default": false
    },
    "documentary": {
      "type": "boolean",
      "default": false
    },
    "strict_provenance": {
      "type": "boolean",
      "default": false
    },
    "purpose": {
      "type": "string"
    },
    "orientation": {
      "enum": [
        "landscape",
        "portrait",
        "square"
      ]
    },
    "shots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "shot_id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "queries": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "topics": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "duration_s": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "will_edit": {
            "type": "boolean",
            "default": true
          }
        },
        "required": [
          "shot_id",
          "description",
          "queries",
          "topics",
          "duration_s"
        ]
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "title",
    "use",
    "ai",
    "orientation",
    "shots"
  ]
}
