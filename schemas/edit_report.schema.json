{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://footage-scout.invalid/edit_report.schema.json",
  "title": "edit_report",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "brief_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "asset_id": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "changes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "enum": [
                    "trim",
                    "crop",
                    "scale",
                    "speed",
                    "color",
                    "stabilize",
                    "denoise",
                    "audio_removed",
                    "audio_replaced",
                    "overlay",
                    "composite",
                    "ai_edit",
                    "other"
                  ]
                },
                "detail": {
                  "type": "string",
                  "maxLength": 300
                }
              },
              "required": [
                "kind"
              ]
            },
            "minItems": 1,
            "maxItems": 50
          }
        },
        "required": [
          "asset_id",
          "sha256",
          "changes"
        ]
      },
      "minItems": 1,
      "maxItems": 500
    }
  },
  "required": [
    "schema_version",
    "brief_sha256",
    "items"
  ]
}
