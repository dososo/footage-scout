{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://footage-scout.invalid/doctor.schema.json",
  "title": "doctor",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "os": {
      "type": "string",
      "minLength": 1
    },
    "level": {
      "enum": [
        "none",
        "core",
        "media",
        "mine",
        "vision"
      ]
    },
    "browser_handoff": {
      "type": "boolean"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "level": {
            "enum": [
              "core",
              "media",
              "mine",
              "vision",
              "browser"
            ]
          },
          "ok": {
            "type": "boolean"
          },
          "version": {
            "type": [
              "string",
              "null"
            ]
          },
          "install_hint": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "name",
          "level",
          "ok",
          "version",
          "install_hint"
        ]
      },
      "minItems": 1
    },
    "executed_install": {
      "const": false
    }
  },
  "required": [
    "schema_version",
    "os",
    "level",
    "browser_handoff",
    "checks",
    "executed_install"
  ]
}
